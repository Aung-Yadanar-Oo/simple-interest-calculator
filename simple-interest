#!/bin/bash

# Simple Interest Calculator
# Usage: ./simple-interest.sh <principal> <rate> <time>
# Example: ./simple-interest.sh 1000 5 2

if [ $# -ne 3 ]; then
    echo "Usage: ./simple-interest.sh <principal> <rate> <time>"
    echo "Example: ./simple-interest.sh 1000 5 2"
    exit 1
fi

principal=$1
rate=$2
time=$3

# Validate inputs are numbers
if ! [[ "$principal" =~ ^[0-9]+\.?[0-9]*$ ]]; then
    echo "Error: Principal must be a number"
    exit 1
fi

if ! [[ "$rate" =~ ^[0-9]+\.?[0-9]*$ ]]; then
    echo "Error: Rate must be a number"
    exit 1
fi

if ! [[ "$time" =~ ^[0-9]+\.?[0-9]*$ ]]; then
    echo "Error: Time must be a number"
    exit 1
fi

# Calculate simple interest
# SI = (P × R × T) / 100
simple_interest=$(echo "scale=2; ($principal * $rate * $time) / 100" | bc)

echo "Simple Interest Calculator"
echo "=========================="
echo "Principal: $principal"
echo "Rate: $rate%"
echo "Time: $time years"
echo "=========================="
echo "Simple Interest: $simple_interest"
echo "Total Amount: $(echo "scale=2; $principal + $simple_interest" | bc)"
